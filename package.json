{
  "name": "curryclient",
  "version": "2.0.2",
  "private": true,
  "description": "Rust and Tauri VRChat companion",
  "license": "GPL-3.0-only",
  "repository": "https://github.com/TheApple05/CurryExternalVRC.git",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tauri dev",
    "tauri": "tauri",
    "build:frontend": "node scripts/build.cjs",
    "test": "node --test test/*.test.cjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "pack": "tauri build --no-bundle",
    "dist:win": "tauri build --bundles nsis",
    "dist:linux": "tauri build --bundles deb,appimage"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "playwright-core": "1.65.0"
  }
}
